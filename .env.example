# 加密密钥 - 32字节 (64个十六进制字符)
# Docker 部署时自动生成，本地开发需手动设置
# 生成命令: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-key-here-generate-with-openssl-rand-hex-32

# Admin Authentication
# Docker 部署时自动生成，本地开发需手动设置
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-session-secret-here

# Docker 部署: 只需设置 ADMIN_PASSWORD (明文，非纯空白，最多72个UTF-8字节)
ADMIN_PASSWORD=your-admin-password

# 本地开发: 需要 bcrypt hash
# Generate with: node -e "require('bcryptjs').hash('your-password', 10).then(console.log)"
# ADMIN_PASSWORD_HASH=your-bcrypt-hash-here

# 可选：部署在 HTTPS 或其他外部代理后时，填写公开访问来源
# NEXT_PUBLIC_BASE_URL=https://paste.example.com

# 仅在入口代理覆盖 X-Real-IP 且应用端口不对外开放时启用。
# Docker Compose 已配置对应入口；直接运行时保持 false（共享访问限制）。
TRUST_PROXY=false
